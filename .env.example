# Copy to backend/.env. Never commit that file.
BAILIAN_API_KEY=
# OpenAI-compatible base URL for your Bailian workspace and region.
BAILIAN_BASE_URL=
BAILIAN_TEXT_MODEL=qwen3.7-flash
BAILIAN_VISION_MODEL=qwen3.7-flash
# Optional free OpenAlex API key for a personal daily search budget.
OPENALEX_API_KEY=
DATABASE_URL=sqlite:///./data/app.db
UPLOAD_DIR=./data/uploads
MAX_PDF_SIZE_MB=100
FRONTEND_ORIGIN=http://127.0.0.1:3000
