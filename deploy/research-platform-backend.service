[Unit]
Description=Research Platform FastAPI backend
After=network.target

[Service]
Type=simple
User=researchplatform
Group=researchplatform
WorkingDirectory=/opt/research-platform/current/backend
EnvironmentFile=/etc/research-platform/backend.env
ExecStart=/opt/research-platform/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/research-platform
MemoryMax=800M

[Install]
WantedBy=multi-user.target
